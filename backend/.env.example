# Server
PORT=5000
NODE_ENV=development

# Database — Update with your PostgreSQL / Supabase credentials
DATABASE_URL="postgresql://postgres:password@localhost:5432/smartbid_db?schema=public"
# Direct URL (used by Prisma for Supabase migrations/db push on port 5432 while DATABASE_URL uses pooler port 6543)
DIRECT_URL="postgresql://postgres:password@localhost:5432/smartbid_db?schema=public"

# JWT
JWT_SECRET=smartbid_super_secret_jwt_key_change_in_production_2025
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Email (optional — configure for real email alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@smartbidsolutions.in

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ── Optional production settings (leave unset for local dev; app behaves as before) ──
# Trust N reverse-proxy hops (nginx / Render) so rate limiting sees real client IPs
# TRUST_PROXY=1
# Timezone for the daily 06:00 tender sync cron (defaults to server time)
# CRON_TZ=Asia/Kolkata
# Set to true on hosts that sleep (Render free) and trigger the sync via GitHub Actions instead
# DISABLE_INTERNAL_CRON=true
# Enables POST /api/internal/sync-tenders (header x-cron-secret must match). Unset = route returns 404
# CRON_SECRET=generate_a_long_random_string
# Store admin uploads on Cloudinary instead of the local uploads/ folder
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Tender portal proxy (only when the API runs outside India; see DEPLOYMENT.md "Tender portal proxy")
# PORTAL_PROXY_URL=https://<project-ref>.supabase.co/functions/v1/portal-proxy
# PORTAL_PROXY_SECRET=
